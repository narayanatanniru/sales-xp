# === Frontend (Vite) ===
# Override the branch-based Supabase target resolver
# VITE_SUPABASE_ENV=dev

# Enable debug logging in the browser console
# VITE_DEBUG_LOGS=true


# === Edge Function (Deno) — save as .env.edge ===
# Required for running the edge function locally:
# SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<your-dev-service-role-key>

# Optional — feature-specific:
# ANTHROPIC_API_KEY=<for Agent E / Autopilot / analytics>
# OPENAI_API_KEY=<for AI image generation>
# MAILGUN_API_KEY=<for transactional email>
# MAILGUN_DOMAIN=mail.yourdomain.com
# STRIPE_SECRET_KEY=<for coin purchases>
# STRIPE_PUBLISHABLE_KEY=<for Stripe Elements>
# TANGO_PLATFORM_NAME=<for gift card fulfilment>
# TANGO_PLATFORM_KEY=<for gift card fulfilment>
# SALESFORCE_CLIENT_ID=<for Salesforce OAuth KPI sync>
# SALESFORCE_CLIENT_SECRET=<for Salesforce OAuth>
# SALESFORCE_REDIRECT_URI=<callback URL>
# GIPHY_API_KEY=<for shoutout GIF search>
